# Copy to `.env` and fill in real values. Do NOT commit `.env`.

# --- App ---
APP_NAME=local-llm-chat
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# SQLite file lives at backend/data/app.db by default.
DATABASE_URL=sqlite:///./data/app.db

# --- Auth (JWT) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-real-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM providers ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
