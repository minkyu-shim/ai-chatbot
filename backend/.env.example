# All keys are server-side only. Never expose as VITE_*.
# Copy to `.env` and fill in real values. Do NOT commit `.env`.

# --- App ---
APP_NAME=weathering-with-you
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# SQLite file lives at backend/data/app.db by default.
DATABASE_URL=sqlite:///./data/app.db

# --- Auth (JWT) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Alt: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM providers ---
LLM_PROVIDER=groq
# Model name persisted on each diary entry (entries.model). Should match the
# active provider's model.
LLM_MODEL=llama-3.1-8b-instant

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- External APIs ---
# OpenWeatherMap — required for diary entry creation (server-side only).
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Unsplash — optional. When blank, fetch_outfit_photo() returns None and the UI
# degrades silently (ADR-13).
UNSPLASH_ACCESS_KEY=
UNSPLASH_BASE_URL=https://api.unsplash.com

# --- Seed admin ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234
